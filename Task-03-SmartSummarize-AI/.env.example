# ========================================================
# SmartSummarize AI - Environment Configuration Template
# ========================================================
# 1. Duplicate this file and rename it to: .env.local
# 2. Obtain your free Gemini API Key from Google AI Studio:
#    https://aistudio.google.com/apikey
# 3. Paste your real API key below (never commit .env.local to Git)

# Google Gemini API Key (Server-side only)
GEMINI_API_KEY=your_gemini_api_key_here

# Supported Gemini Model (Default: gemini-3.1-flash-lite)
# Supported options: gemini-3.1-flash-lite, gemini-3.8-flash, gemini-2.5-pro
GEMINI_MODEL=gemini-3.1-flash-lite
